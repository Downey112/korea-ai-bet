	measure 'Latest Chip Share' =
			VAR latest_m = CALCULATE ( MAX ( fact_kr_chip_usd_month[month] ), REMOVEFILTERS ( fact_kr_chip_usd_month ) )
			RETURN CALCULATE ( AVERAGE ( fact_kr_chip_usd_month[chip_share_pct_est] ), fact_kr_chip_usd_month[month] = latest_m )
		formatString: 0.0\%
		displayFolder: 3 Exposure
		lineageTag: 63fc639c-dc7c-5617-9823-d95f4e1b793f

	measure 'Latest Chip Share Label' =
			VAR latest_m = CALCULATE ( MAX ( fact_kr_chip_usd_month[month] ), REMOVEFILTERS ( fact_kr_chip_usd_month ) )
			RETURN FORMAT ( latest_m, "mmm yyyy" ) & ", estimated, HS 8542 basis"
		displayFolder: 3 Exposure
		lineageTag: 195a3497-231c-566d-be68-411b648bb59d

	measure 'Tax Chip r Lag1' = CALCULATE ( AVERAGE ( mart_tax_chip_correlation[pearson_r] ), mart_tax_chip_correlation[lag] = 1 )
		formatString: 0.00
		displayFolder: 3 Exposure
		lineageTag: 772fdd17-7a63-55d1-89ce-d13443c6f86b

	measure 'Tax Chip r Lag1 Label' =
			VAR n1 = CALCULATE ( MAX ( mart_tax_chip_correlation[n] ), mart_tax_chip_correlation[lag] = 1 )
			VAR r0 = CALCULATE ( AVERAGE ( mart_tax_chip_correlation[pearson_r] ), mart_tax_chip_correlation[lag] = 0 )
			RETURN "n = " & n1 & " years; same-year r = " & FORMAT ( r0, "0.00" )
		displayFolder: 3 Exposure
		lineageTag: 982f8ead-daeb-5394-9c6d-16244bd867d2

	measure 'Corp Tax 2027 vs 2024' =
			VAR proj27 = CALCULATE ( SUM ( budget_2027[amount_trn_won] ), budget_2027[item] = "Corporate tax 2027 (projected)" )
			VAR act24 = CALCULATE ( SUM ( fact_kr_tax_year[corporate_tax_trn_won] ), fact_kr_tax_year[year] = 2024 )
			RETURN DIVIDE ( proj27, act24 )
		formatString: 0.0\x
		displayFolder: 3 Exposure
		lineageTag: 9f76ba8f-5a51-500e-85fd-5f15c869bd0e

	measure 'Corp Tax 2027 vs 2024 Label' =
			VAR proj27 = CALCULATE ( SUM ( budget_2027[amount_trn_won] ), budget_2027[item] = "Corporate tax 2027 (projected)" )
			VAR act24 = CALCULATE ( SUM ( fact_kr_tax_year[corporate_tax_trn_won] ), fact_kr_tax_year[year] = 2024 )
			RETURN FORMAT ( proj27, "#,0.0" ) & " trn won projected vs " & FORMAT ( act24, "#,0.0" ) & " in 2024"
		displayFolder: 3 Exposure
		lineageTag: 2b3d6fe8-8414-5fb4-bca6-43c53197a0f7

