	measure 'Boom price share %' = AVERAGE ( mart_boom_decomposition[price_share_pct] )
		formatString: 0.0\%
		displayFolder: 2 Boom
		lineageTag: dea5763f-42f5-5c94-8c73-9ffb13ea2849

	measure 'Current Boom Value Change' = CALCULATE ( AVERAGE ( mart_boom_decomposition[value_change_pct] ), mart_boom_decomposition[is_current_boom] = TRUE () )
		formatString: +0.0\%;-0.0\%;0.0\%
		displayFolder: 2 Boom
		lineageTag: ee8c1012-26e5-5311-87d4-491963ad45ba

	measure 'Current Boom Period Label' =
			VAR s = CALCULATE ( MIN ( mart_boom_decomposition[start_month] ), mart_boom_decomposition[is_current_boom] = TRUE () )
			VAR e = CALCULATE ( MAX ( mart_boom_decomposition[end_month] ), mart_boom_decomposition[is_current_boom] = TRUE () )
			RETURN FORMAT ( s, "mmm yyyy" ) & " to " & FORMAT ( e, "mmm yyyy" )
		displayFolder: 2 Boom
		lineageTag: 6076f04d-de59-5ac6-8a67-f8535004d340

	measure 'Current Boom Price Share' = CALCULATE ( AVERAGE ( mart_boom_decomposition[price_share_pct] ), mart_boom_decomposition[is_current_boom] = TRUE () )
		formatString: 0.0\%
		displayFolder: 2 Boom
		lineageTag: cb45a9c8-e906-5866-8a9b-24ceaf3b5e2b

	measure 'Current Boom Price Share Label' = "of the rise came from higher prices"
		displayFolder: 2 Boom
		lineageTag: b4830ef4-2b11-5ef9-b19b-938175e727c1

	measure 'Downturn 2001 Drop' = CALCULATE ( AVERAGE ( mart_chip_episodes[drop_pct] ), YEAR ( mart_chip_episodes[start_month] ) = 2001 )
		formatString: +0.0\%;-0.0\%;0.0\%
		displayFolder: 2 Boom
		lineageTag: 7e93610c-e65c-5229-a408-89e2867642ee

	measure 'Downturn 2001 Label' =
			VAR p = CALCULATE ( AVERAGE ( mart_chip_episodes[price_change_pct] ), YEAR ( mart_chip_episodes[start_month] ) = 2001 )
			VAR v = CALCULATE ( AVERAGE ( mart_chip_episodes[volume_change_pct] ), YEAR ( mart_chip_episodes[start_month] ) = 2001 )
			RETURN "prices " & FORMAT ( p, "0.0" ) & "%, volume " & FORMAT ( v, "0.0" ) & "%"
		displayFolder: 2 Boom
		lineageTag: a9570599-426b-5e94-ab93-e34344dd7f48

	measure 'Chip share of exports % (est)' = AVERAGE ( fact_kr_chip_usd_month[chip_share_pct_est] )
		formatString: 0.0\%
