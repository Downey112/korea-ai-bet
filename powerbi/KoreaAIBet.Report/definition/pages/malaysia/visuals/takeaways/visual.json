  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Korea's bet holds only while chip prices hold",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11.5pt",
                      "color": "#C0392B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This boom is the first since 2000 to rest mainly on prices. From September 2000 to July 2001, chip prices fell by two-thirds, and Korean corporate tax follows chips a year later.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1B2430"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1B2430"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Malaysia is more exposed on trade, less on tax",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11.5pt",
                      "color": "#D9A441"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Chips are a bigger share of Malaysia's exports than of Korea's. Gross export value is not value added, though: much of it can be assembly, testing and re-exports, so a bust would reach Malaysia more through orders and jobs than through tax.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1B2430"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1B2430"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Copying the budget would not copy the base",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11.5pt",
                      "color": "#1F3A5F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Korea spends 4.94% of GDP on research and Malaysia 1.01%. A Korea-style megaproject budget would land on a much smaller research base.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1B2430"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
